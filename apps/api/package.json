{
  "name": "@gottaeat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/migrate.ts && tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:token": "tsx --env-file-if-exists=../../.env scripts/dev-token.ts",
    "openapi:export": "tsx scripts/openapi-export.ts",
    "grant-admin": "tsx --env-file-if-exists=../../.env scripts/grant-admin.ts",
    "house:setup": "tsx --env-file-if-exists=../../.env scripts/house-setup.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/swagger": "9.9.2",
    "@gottaeat/schemas": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "tsx": "4.23.15",
    "ulid": "3.0.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2"
  }
}
