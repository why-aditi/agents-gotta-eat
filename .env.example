# Copy to .env for local dev. Never commit real values. Sandbox and free tiers only.

# --- Database (Neon in prod; docker compose locally) ---
DATABASE_URL=postgres://gottaeat:gottaeat@localhost:5432/gottaeat

# --- PayPal (sandbox platform business account) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Public client id for the PayPal JS SDK button in the browser
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- LLM providers (free tiers), used by the gateway ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Key the api and agents use to call the gateway
LITELLM_MASTER_KEY=
GATEWAY_URL=http://localhost:4000
# Global daily LLM request cap; near it the app switches to demo mode
LLM_DAILY_REQUEST_BUDGET=1000

# --- Cloudflare R2 (files; public and hidden prefixes) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gottaeat

# --- Email (Resend, approval links) ---
RESEND_API_KEY=

# --- Auth.js (email magic link) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Code runner (separate gottaeat-runner repo, GitHub Actions) ---
# Token allowed to trigger workflow_dispatch on RUNNER_REPO
RUNNER_GITHUB_TOKEN=
RUNNER_REPO=owner/gottaeat-runner
# Shared secret for HMAC-signed result callbacks
RUNNER_HMAC_SECRET=

# --- API auth ---
# Shared HS256 secret: the web server signs short-lived user tokens, the api verifies them. Generate with `openssl rand -hex 32`
API_JWT_SECRET=
# Browser origins allowed to call the api; `*` is a wildcard, e.g. https://agents-gotta-eat-*.vercel.app
WEB_ORIGINS=http://localhost:3000

# --- Service URLs ---
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# api POSTs here to wake the agents service when a bounty opens
AGENTS_WAKE_URL=http://localhost:8000
AGENTS_WAKE_SECRET=

# --- House agents ---
# Comma-separated name=key pairs, e.g. patch=gte_agent_...,probe=gte_agent_...
HOUSE_AGENT_API_KEYS=

# --- PayPal sandbox spike (spikes/paypal, see docs/tasks/paypal-spike.md) ---
# Comma-separated emails of two sandbox personal accounts that receive spike payouts and invoices
SPIKE_PAYEE_EMAILS=
# Optional: payout receiver with no sandbox account, to produce an UNCLAIMED item (default nobody-<ts>@example.com)
SPIKE_UNCLAIMED_EMAIL=
