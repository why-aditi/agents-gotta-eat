# Copy to .env for local dev. Never commit real values. Sandbox and free tiers only.

# --- Database (Neon in prod; docker compose locally) ---
DATABASE_URL=postgres://gottaeat:gottaeat@localhost:5432/gottaeat

# --- PayPal (sandbox platform business account) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# The Treasurer's Agent Toolkit (ops-01) reuses PAYPAL_CLIENT_ID/SECRET and always targets the sandbox; with a
# http://localhost fake base it falls back to direct API calls. No new variables.
# Public client id for the PayPal JS SDK button in the browser
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- LLM providers (free tiers), used by the gateway ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Key the api and agents use to call the gateway
LITELLM_MASTER_KEY=
GATEWAY_URL=http://localhost:4000
# Global daily cap on api → gateway requests (UTC day). At the cap, calls fail closed: compile 502, gate 2 asks,
# no AI ranking. Demo mode near the cap is a later slice
LLM_DAILY_REQUEST_BUDGET=1000

# --- Cloudflare R2 (files; public and hidden prefixes) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gottaeat

# --- Email (Resend, approval links) ---
RESEND_API_KEY=

# --- Auth.js (web owner sign-in) ---
# Encrypts the session cookie. Generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# GitHub OAuth app (callback https://<web>/api/auth/callback/github). GitHub sign-in shows only when both are set
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# `true` adds a no-password "Continue as demo owner" button (demo-owner@gottaeat.dev). Demo and dev only
DEMO_LOGIN=

# --- Code runner (separate gottaeat-runner repo, GitHub Actions) ---
# Token allowed to trigger workflow_dispatch on RUNNER_REPO
RUNNER_GITHUB_TOKEN=
RUNNER_REPO=owner/gottaeat-runner
# Shared secret for HMAC-signed result callbacks
RUNNER_HMAC_SECRET=

# --- API auth ---
# Shared HS256 secret: the web server signs short-lived user tokens, the api verifies them. Generate with `openssl rand -hex 32`
API_JWT_SECRET=
# Browser origins allowed to call the api; `*` is a wildcard, e.g. https://agents-gotta-eat-*.vercel.app
WEB_ORIGINS=http://localhost:3000

# --- Policy engine ---
# Gate 2 stub. When set it wins over the LLM intent check: `ask` sends every spend that passes gate 1 to the owner;
# `allow` lets it through. Leave empty to use the LLM intent check via GATEWAY_URL (no gateway: every spend asks)
POLICY_GATE2_STUB=ask
# Dev/demo only: enables POST /v1/admin/wallets/:userId/credit until PayPal top-ups (pm-04)
ALLOW_DEV_CREDIT=
# Dev/demo only: enables POST /v1/admin/bounties/:id/open (fake escrow, no PayPal) until pm-04
ALLOW_DEV_FUNDING=
# pnpm seed: the poster account that owns the demo bounties
SEED_POSTER_EMAIL=demo-poster@gottaeat.dev

# --- Service URLs ---
# The web server calls the api here (server-side only; the browser never calls the api with a token)
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# api POSTs here (full URL) to wake the agents service when a bounty opens; unset → no call.
# Shared secret, sent as X-Wake-Secret; the agents service refuses /wake while it is unset. `openssl rand -hex 32`
AGENTS_WAKE_URL=http://localhost:8000/wake
AGENTS_WAKE_SECRET=
# Proxy hops in front of the api, so the demo rate limit (30/min per IP on /v1/demo/*) sees the client IP.
# Unset locally. 2 on Render: Render's proxy, then the web server, which forwards the visitor's address
# (X-Forwarded-For) on its /v1/demo/* calls. A direct caller can spoof it; the limit only keeps casual load off.
TRUST_PROXY_HOPS=

# --- House agents (agents service) ---
# Public api the agents call (agent keys only). GATEWAY_URL and LITELLM_MASTER_KEY above are the LLM gateway
GOTTAEAT_API_URL=http://localhost:3001
# From `pnpm --filter @gottaeat/api house:setup`. An agent without a key is disabled
SIEVE_API_KEY=
SCOUT_API_KEY=
GRIFTER_API_KEY=
# Payee of the Grifter's $40 demo spend (house:setup prints Scout's id)
GRIFTER_PAYEE_AGENT_ID=
# Seconds between polls for open bounties (a wake polls at once)
AGENTS_POLL_SECONDS=60

# --- PayPal sandbox spike (spikes/paypal, see docs/tasks/paypal-spike.md) ---
# Comma-separated emails of two sandbox personal accounts that receive spike payouts and invoices
SPIKE_PAYEE_EMAILS=
# Optional: payout receiver with no sandbox account, to produce an UNCLAIMED item (default nobody-<ts>@example.com)
SPIKE_UNCLAIMED_EMAIL=
