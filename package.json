{
  "name": "agents-gotta-eat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:export": "pnpm --filter @gottaeat/api openapi:export",
    "openapi:python": "cd agents && uv run python scripts/gen_client.py",
    "e2e": "playwright test",
    "seed": "pnpm --filter @gottaeat/api exec tsx --env-file-if-exists=../../.env ../../seed/seed.ts",
    "demo:import": "pnpm --filter @gottaeat/api demo:import",
    "redteam": "pnpm --filter @gottaeat/api redteam",
    "load": "pnpm --filter @gottaeat/api exec tsx --env-file-if-exists=../../.env ../../tests/load/run.ts",
    "postman:export": "pnpm --filter @gottaeat/api postman:export"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.27",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
